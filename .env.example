NEXT_PUBLIC_APP_NAME=记忆引擎
LOCAL_STORAGE_DIR=storage
# 登录/注册 token 的签名密钥。缺失不会报错，会静默用 auth.ts 里的开发默认值，
# 等于公开密钥——线上必须显式填一个随机串。
JWT_SECRET=

TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_API_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
TRANSCRIPTION_API_RESOURCE_ID=volc.bigasr.auc_turbo
TRANSCRIPTION_APP_ID=
TRANSCRIPTION_API_KEY=

# TRANSCRIPTION_PROVIDER=xfyun 时必填（volcengine 方案用不到）。
XFYUN_APP_ID=
XFYUN_SECRET_KEY=

LLM_PROVIDER=mock
LLM_API_URL=https://ark.cn-beijing.volces.com/api/v3/responses
LLM_API_KEY=
LLM_MODEL=deepseek-v3-2-251201
